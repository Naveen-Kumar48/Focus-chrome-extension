{
  "manifest_version": 3,
  "name": "FocusFlow — Focus Timer & Website Blocker",
  "version": "1.1.0",
  "description": "Boost productivity with smart website blocking, custom Pomodoro focus timers, and focus profiles.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "tabs",
    "offscreen"
  ],
  "incognito": "spanning",
  "commands": {
    "toggle-focus": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Start or pause focus timer"
    },
    "block-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Block the current website in active profile"
    }
  },
  "host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusFlow",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
