{
  "name": "focusflow-monorepo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "FocusFlow: Production-ready Focus & Website Blocker Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:extension": "npm --workspace=apps/extension run dev",
    "build:extension": "npm --workspace=apps/extension run build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "eslint .",
    "test": "npm run --workspaces --if-present test",
    "test:e2e": "playwright test",
    "package:extension": "node scripts/package-extension.js",
    "build": "npm run --workspaces --if-present build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "typescript": "^5.7.3"
  }
}
