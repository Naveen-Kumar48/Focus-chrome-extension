{
  "name": "focusflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FocusFlow: Production-ready Focus & Website Blocker Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:extension": "npm --workspace=apps/extension run dev",
    "build:extension": "npm --workspace=apps/extension run build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint",
    "test": "npm run --workspaces --if-present test",
    "build": "npm run --workspaces --if-present build"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
